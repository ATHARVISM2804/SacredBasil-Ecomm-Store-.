# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard > Account & Settings > API Keys). Use test keys until launch.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: point to /api/webhooks/razorpay and set this secret.
RAZORPAY_WEBHOOK_SECRET=

# Resend (order and enquiry emails). Optional until launch.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Sacred Basil <orders@example.com>"
ADMIN_NOTIFY_EMAIL=contactsacredbasil@gmail.com

# Optional: also forward enquiries to a webhook (Formspree, Zapier, CRM).
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=

# Optional: secret for signed order receipt links (defaults to RAZORPAY_KEY_SECRET)
ORDER_RECEIPT_SECRET=
# Optional: show Google sign-in once enabled in Supabase
NEXT_PUBLIC_AUTH_GOOGLE=
