# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# gstack browser profile (contains login cookies)
.gstack/
!.env.example

# Media working files (raw frames, AI clips, exports, photo sources). Kept on
# disk only; the published assets live in public/.
/docs/hero-film/**/*.mp4
/docs/hero-film/**/*.png
/docs/hero-film/**/*.jpg
/docs/hero-film/**/*.wav
/docs/product-photos/**/*.png
/docs/product-photos/**/*.jpg
/docs/product-photos/**/*.jpeg
/docs/product-photos/**/*.webp
/docs/product-photos/**/*.heic
/docs/inputs/**/*
!/docs/inputs/SB Diwali Gifting Collection.pdf
/reel/
/docs/product-photos/**/*.mp4
/docs/site-images/**/*.png

# Playwright
/test-results/
/playwright-report/

# Image-generation working files (AI drafts, upload packs). Published
# versions live in public/; prompts and READMEs stay tracked.
/docs/gen/
/docs/regen/send/
/docs/regen2/send/
/docs/regen2/incoming/
/docs/site-images/**/*.webp
/docs/site-images/**/*.jpg
__pycache__/
/scripts/.*.mjs
